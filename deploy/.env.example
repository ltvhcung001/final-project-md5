# Copy to deploy/.env on the VPS and fill in real values. Never commit .env.
DOMAIN=example.com
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

JWT_SECRET=replace-with-at-least-32-random-bytes

# first ADMIN account (created on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# memory tuning: 256m per Java service is fine for the demo; lower it on small instances
JAVA_XMX=256m

# optional components (compose profiles "search" / "monitoring")
SEARCH_ENABLED=false

# true = the MOCK payment method works (sandbox demo / load test); set false for real-money use
PAYMENT_MOCK_ENABLED=true

# gateway rate limit per client IP per minute; raise it for load tests
RATE_LIMIT_RPM=120

# Swagger UI at https://api.<DOMAIN>/swagger-ui.html (handy for a demo, turn it off afterwards)
SWAGGER_ENABLED=false

POSTGRES_ADMIN_PASSWORD=
IDENTITY_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=

RABBITMQ_USER=omnichannel
RABBITMQ_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# VNPay / MoMo sandbox credentials
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# SMTP (e.g. Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
