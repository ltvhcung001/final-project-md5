# Copy to deploy/.env on the VPS and fill in real values. Never commit .env.
DOMAIN=example.com
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

JWT_SECRET=replace-with-at-least-32-random-bytes

POSTGRES_ADMIN_PASSWORD=
IDENTITY_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=

RABBITMQ_USER=omnichannel
RABBITMQ_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# VNPay / MoMo sandbox credentials
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# SMTP (e.g. Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
